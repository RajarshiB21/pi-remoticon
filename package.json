    "@termless/vterm": "0.9.1",
    "@types/node": "^26.4.1",
    "node-pty": "^1.1.0",
    "termless": "0.9.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
